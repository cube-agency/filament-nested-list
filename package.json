{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm-run-all --parallel dev:*",
        "dev:js": "node bin/build.js --dev",
        "dev:css": "tailwindcss -i ./resources/css/index.css -o ./resources/dist/filament-nested-list.css --watch",
        "build": "npm-run-all build:*",
        "build:js": "node bin/build.js",
        "build:css": "tailwindcss -i ./resources/css/index.css -o ./resources/dist/filament-nested-list.css --minify",
        "test": "node --test \"resources/js/*.test.js\"",
        "prettier": "npx prettier --write ."
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.0.0",
        "esbuild": "^0.25.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.0",
        "prettier-plugin-blade": "^2.1.21",
        "prettier-plugin-tailwindcss": "^0.6.13",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "sortablejs": "^1.15.3"
    }
}
